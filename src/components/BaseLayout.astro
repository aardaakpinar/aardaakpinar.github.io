---
import "@/styles/global.css";
import { getSite } from "@/lib/content";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const site = await getSite();
const { title = site.name, description = site.description, image = site.ogImage } = Astro.props;
const origin = Astro.site!;
const canonical = new URL(Astro.url.pathname, origin).href;
const imageUrl = new URL(image, origin).href;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <!-- Fragment links should land instantly; smooth scrolling comes back after load. -->
    <script is:inline>
      if (location.hash) document.documentElement.style.scrollBehavior = "auto";
      window.addEventListener("load", () => {
        document.documentElement.style.scrollBehavior = "";
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={imageUrl} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={site.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Nunito:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.boxicons.com/3.0.8/fonts/brands/boxicons-brands.min.css" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
