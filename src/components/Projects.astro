---
import { getCopy, getProjects } from "@/lib/content";
import Section from "@/components/Section.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import "@/styles/projects.css";

const [copy, projects] = await Promise.all([getCopy(), getProjects()]);
---

<Section
	id={copy.nav.work.id}
	padding="flush"
	labelledby="work-title"
	class="work-section"
>
	<div class="project-sticky">
		<SectionHeading id="work-title" heading={copy.projects.heading} />
		<div class="project-viewport">
			<div class="project-grid">
				{projects.map((project) => <ProjectCard {...project} />)}
			</div>
		</div>
	</div>
</Section>

<script>
	import "@/scripts/project-scroller";
</script>
