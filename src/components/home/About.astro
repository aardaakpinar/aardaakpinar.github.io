---
import { getExperience, getPage, getSite } from "../../lib/content";
import { render } from "astro:content";
import Heading from "../ui/Heading.astro";
import TechStack from "./TechStack.astro";

const { about } = await getSite();
const experience = await getExperience();
const { Content } = await render(await getPage("about"));
---

<section class="story-section" id="about" aria-labelledby="about-title">
	<div class="section-heading"><Heading id="about-title" {...about.heading} /></div>
	
	<div class="about-container">
		<div class="about-bio">
			<Content />
		</div>

		<div class="about-experience" aria-label="Experience and education">
			<h3 class="about-subheading">{about.experienceTitle}</h3>
			<div class="about-exp-list">
				{
					experience.map((item) => (
						<article class="about-exp-item">
							<div class="about-exp-meta">
								<span class="about-exp-period">{item.period}</span>
							</div>
							<div class="about-exp-content">
								<h4 class="about-exp-title">{item.title}</h4>
								<p class="about-exp-detail">{item.detail}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</div>

	<TechStack />
</section>
