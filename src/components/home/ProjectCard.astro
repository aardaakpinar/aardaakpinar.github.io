---
import { formatShortDate } from "../../lib/format";

interface Props {
	title: string;
	logo?: string;
	description: string;
	started?: Date;
	source: string;
	website?: string;
}

const { title, logo, description, started, source, website } = Astro.props;
---

<article class="project-card">
	<div class="project-meta">
		{logo && <img class="project-logo" src={logo} alt="" loading="lazy" decoding="async" />}
		<h3>{title}</h3>
		{started && <time datetime={started.toISOString().slice(0, 10)}>{formatShortDate(started)}</time>}
	</div>
	<p>{description}</p>
	<div class="project-links">
		<a href={source} target="_blank" rel="noopener noreferrer">Source</a>
		{website && <a href={website} target="_blank" rel="noopener noreferrer">Website</a>}
	</div>
</article>
