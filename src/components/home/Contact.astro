---
import { getLinks, getSite } from "../../lib/content";
import Heading from "../ui/Heading.astro";

const { contact } = await getSite();
const links = await getLinks();
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
	<div class="contact-content">
		<Heading id="contact-title" {...contact.heading} />
		<a class="button" href={`mailto:${contact.email}`}>{contact.buttonLabel}</a>
	</div>
	<div class="social-grid">
		{
			links.map((link) => (
				<a href={link.href} target="_blank" rel="me noopener noreferrer">
					<i class={`bxl ${link.icon}`} aria-hidden="true" />
					<span>
						<strong>{link.label}</strong>
					</span>
				</a>
			))
		}
	</div>
</section>
