---
import { tagHref } from "@/lib/posts";
import Chip from "@/components/Chip.astro";
import "@/styles/blog-shell.css";

interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<div class="blog-tags">
			{tags.map((tag) => (
				<Chip class="blog-tag" href={tagHref(tag)}>
					{tag}
				</Chip>
			))}
		</div>
	)
}
