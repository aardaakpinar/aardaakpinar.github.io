---
import { render } from "astro:content";
import { getBio, getCopy } from "@/lib/content";
import Section from "@/components/Section.astro";
import Experience from "./Experience.astro";
import TechStack from "./TechStack.astro";
import "@/styles/about.css";

const [copy, bio] = await Promise.all([getCopy(), getBio()]);
const { Content } = await render(bio);
---

<Section id={copy.nav.about.id} heading={copy.about.heading}>
	<div class="about-container">
		<div class="about-bio">
			<Content />
		</div>
		<Experience />
	</div>

	<TechStack />
</Section>
