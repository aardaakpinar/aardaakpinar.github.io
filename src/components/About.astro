---
import { render } from "astro:content";
import { getBio, getCopy } from "@/lib/content";
import Heading from "@/components/Heading.astro";
import Experience from "./Experience.astro";
import TechStack from "./TechStack.astro";
import "@/styles/about.css";

const [copy, bio] = await Promise.all([getCopy(), getBio()]);
const { Content } = await render(bio);
---

<section class="story-section" id={copy.nav.about.id} aria-labelledby="about-title">
	<div class="section-heading"><Heading id="about-title" {...copy.about.heading} /></div>

	<div class="about-container">
		<div class="about-bio">
			<Content />
		</div>
		<Experience />
	</div>

	<TechStack />
</section>
