---
interface Props {
	/** Path shown after "~", e.g. "/blog" */
	crumb: string;
	actionLabel: string;
	actionHref: string;
}

const { crumb, actionLabel, actionHref } = Astro.props;
---

<div class="blog-topbar">
	<span class="blog-crumb"><a href="/">~</a>{crumb}</span>
	<a class="button" href={actionHref}>{actionLabel}</a>
</div>
