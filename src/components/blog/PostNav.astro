---
import { postHref } from "../../lib/blog";

interface Neighbor {
	slug: string;
	title: string;
}

interface Props {
	newer: Neighbor | null;
	older: Neighbor | null;
}

const { newer, older } = Astro.props;
---

{
	(newer || older) && (
		<nav class="blog-post-nav" aria-label="More posts">
			{newer && (
				<a class="post-link" href={postHref(newer.slug)}>
					<small>← Newer</small>
					<span>{newer.title}</span>
				</a>
			)}
			{older && (
				<a class="post-link next" href={postHref(older.slug)}>
					<small>Older →</small>
					<span>{older.title}</span>
				</a>
			)}
		</nav>
	)
}
