---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogTopbar from "../../components/blog/BlogTopbar.astro";
import BlogList from "../../components/blog/BlogList.astro";
import Heading from "../../components/ui/Heading.astro";
import Footer from "../../components/ui/Footer.astro";
import { countTags, getPosts, tagHref } from "../../lib/blog";
import { padCount } from "../../lib/format";
import { getSite } from "../../lib/content";

const { name, blog } = await getSite();
const posts = await getPosts();
const allTags = countTags(posts);
---

<BaseLayout title={`${name} | ${blog.title}`} description={blog.description}>
	<main class="site-shell">
		<section class="blog-index-section" aria-labelledby="blog-index-title">
			<BlogTopbar crumb="/blog" actionLabel="Home" actionHref="/" />

			<div class="blog-index-head">
				<Heading as="h1" id="blog-index-title" {...blog.heading} />
			</div>

			{
				allTags.length > 0 && (
					<nav class="blog-filters blog-tags" aria-label="Filter by tag">
						<a class="blog-tag is-active" href="/blog/" data-filter="">
							All<span>{padCount(posts.length)}</span>
						</a>
						{allTags.map(([tag, count]) => (
							<a class="blog-tag" href={tagHref(tag)} data-filter={tag}>
								{tag}
								<span>{padCount(count)}</span>
							</a>
						))}
					</nav>
				)
			}

			<BlogList posts={posts} as="h2" />

			<p class="blog-filter-empty" hidden>{blog.filterEmptyText}</p>
		</section>

		<Footer />
	</main>

	<script>
		import "../../scripts/blog-filter";
	</script>
</BaseLayout>
