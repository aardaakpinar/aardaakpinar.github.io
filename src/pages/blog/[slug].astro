---
import { render } from "astro:content";
import BaseLayout from "@/components/BaseLayout.astro";
import Button from "@/components/Button.astro";
import PostNav from "@/components/PostNav.astro";
import PostChrome from "@/components/PostChrome.astro";
import TagList from "@/components/TagList.astro";
import Footer from "@/components/Footer.astro";
import { getCopy, getSite } from "@/lib/content";
import { getPosts, minutesLabel } from "@/lib/posts";
import { formatLongDate } from "@/lib/date";
import "@/styles/blog-post.css";

export async function getStaticPaths() {
	const posts = await getPosts();
	const neighbor = (index: number) => (posts[index] ? { slug: posts[index].slug, title: posts[index].title } : null);

	return posts.map((post, index) => ({
		params: { slug: post.slug },
		props: { post, newer: neighbor(index - 1), older: neighbor(index + 1) },
	}));
}

const [copy, site] = await Promise.all([getCopy(), getSite()]);
const { post, newer, older } = Astro.props;
const { Content } = await render(post.entry);
---

<BaseLayout title={`${site.name} | ${post.title}`} description={post.description}>
	<PostChrome />
	<main class="site-shell">
		<article class="blog-post">
			<header class="blog-post-header">
				<div class="blog-post-head">
					<div class="blog-post-meta">
						<time datetime={post.publishedAt.toISOString()}>{formatLongDate(post.publishedAt)}</time>
						<span>{minutesLabel(copy.blog.minutesRead, post.minutes)}</span>
					</div>
					<Button href="/blog/">{copy.blog.allPosts}</Button>
				</div>
				<h1>{post.title}</h1>
				<p class="blog-post-description">{post.description}</p>
				<TagList tags={post.tags} />
			</header>

			<div class="blog-post-content">
				<Content />
			</div>

			<PostNav newer={newer} older={older} />
		</article>

		<Footer />
	</main>
</BaseLayout>
