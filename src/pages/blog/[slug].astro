---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogTopbar from "../../components/blog/BlogTopbar.astro";
import PostNav from "../../components/blog/PostNav.astro";
import PostChrome from "../../components/blog/PostChrome.astro";
import TagList from "../../components/blog/TagList.astro";
import Footer from "../../components/ui/Footer.astro";
import { getPosts } from "../../lib/blog";
import { formatLongDate } from "../../lib/format";
import { getSite } from "../../lib/content";
import { render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getPosts();
	const neighbor = (index: number) => (posts[index] ? { slug: posts[index].slug, title: posts[index].title } : null);

	return posts.map((post, index) => ({
		params: { slug: post.slug },
		props: { post, newer: neighbor(index - 1), older: neighbor(index + 1) },
	}));
}

const { post, newer, older } = Astro.props;
const { name } = await getSite();
const { Content } = await render(post.entry);
---

<BaseLayout title={`${name} | ${post.title}`} description={post.description}>
	<PostChrome />
	<main class="site-shell">
		<article class="blog-post">
			<BlogTopbar crumb="/blog/" actionLabel="All posts" actionHref="/blog/" />

			<header class="blog-post-header">
				<div class="blog-post-meta">
					<time datetime={post.publishedAt.toISOString()}>{formatLongDate(post.publishedAt)}</time>
					<span>{post.minutes} min read</span>
				</div>
				<h1>{post.title}</h1>
				<p class="blog-post-description">{post.description}</p>
				<TagList tags={post.tags} />
			</header>

			<div class="blog-post-content">
				<Content />
			</div>

			<PostNav newer={newer} older={older} />
		</article>

		<Footer />
	</main>
</BaseLayout>
