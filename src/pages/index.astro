---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import "../styles/sky.css";

const blogEntries = await getCollection("blog");
const latestPosts = blogEntries
	.map((entry) => ({
		slug: entry.data.slug ?? entry.id,
		title: entry.data.title,
		description: entry.data.description,
		publishedAt: entry.data.publishedAt,
		tags: entry.data.tags ?? [],
	}))
	.sort((a, b) => b.publishedAt.valueOf() - a.publishedAt.valueOf())
	.slice(0, 3);

const blogDateFormatter = new Intl.DateTimeFormat("en-US", { day: "2-digit", month: "short", year: "numeric" });

const projects = [
	{ title: "Kargo", logo: "/images/logos/kargo.png", description: "A minimalist Turkish web browser inspired by an existing browser concept.", started: "14 Apr 2026", source: "https://github.com/aardaakpinar/kargo", website: "https://aardaakpinar.github.io/kargo" },
	{ title: "Pitopi", logo: "/images/logos/pitopi.png", description: "A privacy-first, end-to-end encrypted chat platform for secure communication.", started: "01 Aug 2024", source: "https://github.com/aardaakpinar/pitopi", website: "https://aardaakpinar.github.io/pitopi" },
	{ title: "Wall", logo: "https://aardaakpinar.github.io/wall/images/logo.png", description: "A zero-build portfolio engine with modular Bento Grid layouts powered by YAML.", started: "01 Aug 2022", source: "https://github.com/aardaakpinar/wall", website: "https://aardaakpinar.github.io/wall" },
	{ title: "Masa", logo: "/images/logos/masa.png", description: "A JavaScript/Firebase social app with authentication, posts, and real-time synchronization.", started: "01 Aug 2021", source: "https://github.com/aardaakpinar/masa", website: "https://aardaakpinar.github.io/masa" },
	{ title: "Limon", logo: "/images/logos/limon.png", description: "A command-line assistant supporting multiple AI providers, file operations, and risk-based approval.", started: "10 Apr 2020", source: "https://github.com/aardaakpinar/limon", website: "https://aardaakpinar.github.io/limon" },
	{ title: "Bi'Bak", logo: "/images/logos/bibak.png", description: "An RSS/Atom reader with IndexedDB, OPML import, CORS proxy fallback, and real-time updates.", started: "20 Feb 2020", source: "https://github.com/aardaakpinar/bibak", website: "https://aardaakpinar.github.io/bibak" },
];

const techStack = [
	{ name: "JavaScript", icon: "js" },
	{ name: "TypeScript", icon: "ts" },
	{ name: "Vue", icon: "vue" },
	{ name: "Node.js", icon: "nodejs" },
	{ name: "Python", icon: "py" },
	{ name: "PHP", icon: "php" },
	{ name: "C", icon: "c" },
	{ name: "PostgreSQL", icon: "postgres" },
	{ name: "Firebase", icon: "firebase" },
	{ name: "Cloudflare", icon: "cloudflare" },
	{ name: "Docker", icon: "docker" },
	{ name: "Git", icon: "git" },
	{ name: "Kali", icon: "kali" },
];

const links = [
	{ label: "GitHub", handle: "@aardaakpinar", icon: "bx-github", href: "https://github.com/aardaakpinar" },
	{ label: "LinkedIn", handle: "/in/aardaakpinar", icon: "bx-linkedin", href: "https://linkedin.com/in/aardaakpinar/" },
	{ label: "X", handle: "@aardaakpinar", icon: "bx-twitter-x", href: "https://x.com/aardaakpinar" },
	{ label: "YouTube", handle: "@aardaakpinar", icon: "bx-youtube", href: "https://youtube.com/@aardaakpinar" },
];

const experience = [
	{ period: "JUL — AUG 2026", title: "Cyber Security Intern", detail: "PROATAK Siber Güvenlik · Full-time · Istanbul, Turkey" },
	{ period: "SEP 2025 — PRESENT", title: "Istanbul Commerce University", detail: "Associate's degree · Cyber Security" },
];
---

<BaseLayout>
	<main class="site-shell">
		<section class="hero" aria-labelledby="hero-title">
			<div class="sky" aria-hidden="true"></div>
			<div class="rain-container" aria-hidden="true"></div>
			<div class="hero-copy">
				<h1 id="hero-title">I'm<br /><em>Arda Akpınar</em></h1>
				<p class="intro">I am a software developer and cyber security student. I work on open-source software and ideas that keep me curious.</p>
				<nav class="hero-nav" aria-label="Sections">
					<a class="text-link" href="#about">About</a>
					<a class="text-link" href="#blog">Blog</a>
					<a class="text-link" href="#work">Projects</a>
					<a class="text-link" href="#contact">Contact</a>
				</nav>
			</div>
			<div class="hero-mark" aria-label="Arda Akpınar">
				<Image class="hero-profile-image" src="/images/logos/nar.png" alt="Arda Akpınar" width={250} height={250} loading="eager" decoding="async" />
			</div>
		</section>

		<section class="story-section" id="about" aria-labelledby="about-title">
			<div class="story-heading"><h2 id="about-title">Curiosity became <br /><em>creating.</em></h2></div>
			<div class="story-grid">
				<div class="experience-list" aria-label="Experience and education">
					<h2>Experience and education</h2>
					{
						experience.map((item) => (
							<article class="experience-item">
								<>
									<span>{item.period}</span>
									<h3>{item.title}</h3>
									<p>{item.detail}</p>
								</>
							</article>
						))
					}
				</div>
				<div class="story-copy"><p>I discovered programming during the pandemic. <i>“If they can do it, so can I”</i> led me to build my first application, <strong>NAR</strong>.</p><p>Since then, I have been building personal projects, developing my problem-solving skills and curiosity with every experiment. Every project, whether completed, transformed, or a lesson in itself, is part of the journey.</p><p>Today, I look for simple solutions to real problems and still find that the best way to learn is to make.</p></div>
			</div>
			<div class="stack-heading"><h3>Things I Work <em>With.</em></h3></div>
			<div class="stack-marquee" aria-label="Technologies I use">
				<div class="stack-track">
					{
						[...techStack, ...techStack].map((tech, index) => (
							<span class="stack-item" aria-hidden={index >= techStack.length ? "true" : undefined}>
								<img src={`https://skillicons.dev/icons?i=${tech.icon}`} alt="" aria-hidden="true" loading="lazy" />
								{tech.name}
							</span>
						))
					}
				</div>
			</div>
		</section>

		<section class="blog-section" id="blog" aria-labelledby="blog-title">
			<div class="section-heading">
				<div>
					<h2 id="blog-title">Things thought<br /><em>about.</em></h2>
				</div>
				<a class="button" href="/blog/">All posts</a>
			</div>

			{
				latestPosts.length === 0 ? (
					<p class="blog-empty">No posts yet, check back soon.</p>
				) : (
					<div class="blog-grid">
						{latestPosts.map((post) => (
							<article class="blog-card">
								<a class="blog-card-link" href={`/blog/${post.slug}/`}>
									<time datetime={post.publishedAt.toISOString()}>{blogDateFormatter.format(post.publishedAt)}</time>
									<h3>{post.title}</h3>
									<p>{post.description}</p>
								</a>
								{post.tags.length > 0 && (
									<div class="blog-tags">
										{post.tags.map((tag) => (
											<a class="blog-tag" href={`/blog/?tag=${encodeURIComponent(tag.toLowerCase())}`}>
												{tag}
											</a>
										))}
									</div>
								)}
							</article>
						))}
					</div>
				)
			}
		</section>

		<section class="work-section" id="work" aria-labelledby="work-title">
			<div class="project-sticky">
				<div class="section-heading"><h2 id="work-title">A few selected<br /><em>projects.</em></h2></div>
				<div class="project-viewport">
					<div class="project-grid">
						{
							projects.map((project) => (
								<article class="project-card">
									<div class="project-meta">
										{project.logo && <img class="project-logo" src={project.logo} alt="" loading="lazy" decoding="async" />}
										<h3>{project.title}</h3>
										<time>{project.started}</time>
									</div>
									<p>{project.description}</p>
									<div class="project-links">
										<a href={project.source} target="_blank" rel="noopener noreferrer">
											Source
										</a>
										{project.website && (
											<a href={project.website} target="_blank" rel="noopener noreferrer">
												Website
											</a>
										)}
									</div>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<section class="contact-section" id="contact" aria-labelledby="contact-title">
			<div class="contact-content"><h2 id="contact-title">Have an idea?<br /><em>Let's talk.</em></h2><a class="button" href="mailto:aardaakpinar@proton.me">Email me</a></div>
			<div class="social-grid">
				{
					links.map((link) => (
						<a href={link.href} target="_blank" rel="me noopener noreferrer">
							<>
								<i class={`bxl ${link.icon}`} aria-hidden="true" />
								<span>
									<strong>{link.label}</strong>
								</span>
							</>
						</a>
					))
				}
			</div>
		</section>

		<footer><span>© 2026 Arda Akpınar</span><span>Made with ❤️.</span></footer>
	</main>

	<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
	<script>
		const sky = document.querySelector(".hero .sky");
		const rainContainer = document.querySelector(".hero .rain-container");
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (!reducedMotion) {
			const now = new Date();
			const month = now.getMonth() + 1;
			const day = now.getDate();
			const hour = now.getHours();

			if (month === 9 && day === 12) {
				setInterval(createFireworks, 1000);
			} else if (month >= 9 && month <= 11) {
				createRain(50);
			} else if (month === 12 || month <= 2) {
				createSnow(40);
			} else if (month >= 3 && month <= 5) {
				createRain(20);
			}

			if (hour <= 6 || hour >= 18) {
				createStars(30);
				setInterval(() => {
					if (Math.random() < 0.07) createMeteor();
				}, 10000);
			}
		}

		function createRain(count) {
			for (let index = 0; index < count; index += 1) {
				const drop = document.createElement("div");
				drop.className = "rain";
				drop.style.left = `${Math.random() * 100}%`;
				drop.style.animationDuration = `${0.5 + Math.random() * 0.5}s`;
				drop.style.animationDelay = `${Math.random() * 2}s`;
				rainContainer.appendChild(drop);
			}
		}

		function createSnow(count) {
			for (let index = 0; index < count; index += 1) {
				const flake = document.createElement("div");
				flake.className = "snow";
				flake.style.left = `${Math.random() * 100}%`;
				flake.style.animationDuration = `${5 + Math.random() * 5}s`;
				flake.style.animationDelay = `${Math.random() * 5}s`;
				rainContainer.appendChild(flake);
			}
		}

		function createStars(count) {
			for (let index = 0; index < count; index += 1) {
				const star = document.createElement("div");
				star.className = "star";
				star.style.top = `${Math.random() * 100}%`;
				star.style.left = `${Math.random() * 100}%`;
				const size = 1 + Math.random() * 2;
				star.style.width = `${size}px`;
				star.style.height = `${size}px`;
				star.style.setProperty("--dirX", Math.random() > 0.5 ? "1" : "-1");
				star.style.setProperty("--dirY", Math.random() > 0.5 ? "1" : "-1");
				star.style.animationDuration = `${1 + Math.random() * 3}s, ${5 + Math.random() * 5}s`;
				sky.appendChild(star);
			}
		}

		function createMeteor() {
			const meteor = document.createElement("div");
			meteor.className = "meteor";
			meteor.style.top = "-50px";
			meteor.style.left = `${Math.random() * 100}%`;
			const animationName = Math.random() < 0.5 ? "meteorFall1" : "meteorFall2";
			meteor.style.animation = `${animationName} 2s linear forwards`;
			sky.appendChild(meteor);
			setTimeout(() => meteor.remove(), 2500);
		}

		function createFireworks() {
			const colors = ["#FF3C38", "#FFAD33", "#33FFBD", "#3380FF", "#C833FF"];
			const color = colors[Math.floor(Math.random() * colors.length)];
			const firework = document.createElement("div");
			firework.className = "firework";
			firework.style.left = `${Math.random() * 100}%`;
			firework.style.top = "calc(100% - 20px)";
			firework.style.setProperty("--color", color);
			sky.appendChild(firework);

			setTimeout(() => {
				for (let index = 0; index < 8; index += 1) {
					const explosion = document.createElement("div");
					explosion.className = "explosion";
					explosion.style.left = firework.style.left;
					explosion.style.top = "50%";
					const angle = (index / 8) * 2 * Math.PI;
					const distance = 50 + Math.random() * 50;
					explosion.style.setProperty("--x", `${Math.cos(angle) * distance}px`);
					explosion.style.setProperty("--y", `${Math.sin(angle) * distance}px`);
					explosion.style.setProperty("--color", color);
					sky.appendChild(explosion);
					setTimeout(() => explosion.remove(), 800);
				}
				firework.remove();
			}, 800);
		}

		const heroSection = document.querySelector(".hero");
		const sections = [...document.querySelectorAll("main > section[id]")];
		let activeSection = "";

		const updateUrl = (sectionId) => {
			if (sectionId === activeSection) return;
			activeSection = sectionId;
			history.replaceState(null, "", `#${sectionId}`);
		};

		const sectionStates = new Map();
		const sectionObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => sectionStates.set(entry.target.id, entry));
				const observationCenter = window.innerHeight * 0.35;
				const visibleSections = sections
					.map((section) => sectionStates.get(section.id))
					.filter((entry) => entry?.isIntersecting)
					.sort((first, second) => Math.abs(first.boundingClientRect.top - observationCenter) - Math.abs(second.boundingClientRect.top - observationCenter));

				if (visibleSections[0]) updateUrl(visibleSections[0].target.id);
			},
			{ rootMargin: "-25% 0px -55%", threshold: [0, 0.25, 0.5, 0.75, 1] },
		);

		sections.forEach((section) => sectionObserver.observe(section));

		const heroObserver = new IntersectionObserver(
			([entry]) => {
				if (entry.isIntersecting) {
					activeSection = "";
					history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
				}
			},
			{ threshold: 0.25 },
		);

		heroObserver.observe(heroSection);

		const projectSection = document.querySelector(".work-section");
		const projectSticky = document.querySelector(".project-sticky");
		const projectViewport = document.querySelector(".project-viewport");
		const projectGrid = document.querySelector(".project-grid");
		const projectHoldMultiplier = 1.6;
		let projectFrame;

		const getProjectTravelDistance = () => {
			const viewportStyle = getComputedStyle(projectViewport);
			const sidePadding = parseFloat(viewportStyle.paddingLeft) + parseFloat(viewportStyle.paddingRight);

			return Math.max(0, projectGrid.scrollWidth - projectViewport.clientWidth + sidePadding + 10);
		};

		const moveProjects = () => {
			projectFrame = undefined;
			const travelDistance = getProjectTravelDistance();
			const scrollDistance = projectSection.offsetHeight - projectSticky.clientHeight;
			const pinTop = parseFloat(getComputedStyle(projectSticky).top) || 0;
			const sectionProgress = Math.min(1, Math.max(0, (pinTop - projectSection.getBoundingClientRect().top) / scrollDistance));

			projectGrid.style.transform = `translateX(${-travelDistance * sectionProgress}px)`;
		};

		const requestProjectMove = () => {
			if (projectFrame === undefined) projectFrame = requestAnimationFrame(moveProjects);
		};

		const resizeProjects = () => {
			const travelDistance = getProjectTravelDistance();
			projectSticky.style.setProperty("--project-top", `${Math.max(0, (window.innerHeight - projectSticky.offsetHeight) / 2)}px`);
			projectSection.style.height = `${projectSticky.clientHeight + Math.max(0, travelDistance * projectHoldMultiplier)}px`;
			requestProjectMove();
		};

		window.addEventListener("scroll", requestProjectMove, { passive: true });
		window.addEventListener("resize", resizeProjects);
		resizeProjects();
	</script>
</BaseLayout>
