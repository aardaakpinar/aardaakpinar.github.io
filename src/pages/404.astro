---
import BaseLayout from "@/components/BaseLayout.astro";
import Button from "@/components/Button.astro";
import Heading from "@/components/Heading.astro";
import { getCopy, getSite } from "@/lib/content";
import "@/styles/not-found.css";

const [copy, site] = await Promise.all([getCopy(), getSite()]);
const { notFound } = copy;
---

<BaseLayout title={`${site.name} | ${notFound.title}`}>
	<main class="site-shell not-found">
		<p class="eyebrow">404</p>
		<Heading as="h1" {...notFound.heading} />
		<Button href="/">{notFound.button}</Button>
	</main>
</BaseLayout>
